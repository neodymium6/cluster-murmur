#!/bin/sh

# This release is intentionally single-node. Keep remote Erlang control closed.
export RELEASE_DISTRIBUTION=none

# Mix release scripts require a cookie argument even when distribution is off.
# This public placeholder is not an authentication secret and is never used for
# node-to-node communication.
export RELEASE_COOKIE=cluster_murmur_nondistributed

# Preserve UTF-8 native filenames even in minimal release and image runtimes.
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-+fnu}"
